{
  "name": "zcap-spec-example-format",
  "version": "0.1.0",
  "description": "Check and fix the formatting of the JSON examples embedded in the ZCAP spec",
  "keywords": ["zcap", "jsonc", "formatter", "respec", "linter"],
  "homepage": "https://github.com/w3c-ccg/zcap-spec/tree/main/lib/zcap-spec-example-format#readme",
  "bugs": "https://github.com/w3c-ccg/zcap-spec/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/w3c-ccg/zcap-spec.git",
    "directory": "lib/zcap-spec-example-format"
  },
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./index.mjs",
    "./package.json": "./package.json"
  },
  "main": "./index.mjs",
  "bin": {
    "zcap-spec-example-format": "./bin/zcap-spec-example-format.mjs"
  },
  "files": ["index.mjs", "lib/", "bin/", "README.md"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "check": "node bin/zcap-spec-example-format.mjs ../../index.html",
    "fix": "node bin/zcap-spec-example-format.mjs --fix ../../index.html"
  }
}
